# Copy to .env and fill in real values. Never commit .env.
FLASK_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
DATABASE_PATH=safeai.db

# Set true when the app is served over HTTPS in production.
COOKIE_SECURE=false

# Optional temporary preview gate: username:long-random-password
PREVIEW_BASIC_AUTH=

# Twilio Verify credentials. Create a Verify Service in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional URL reputation lookup (Google Safe Browsing Lookup API).
GOOGLE_SAFE_BROWSING_API_KEY=

# Existing AI provider credentials
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OCR_SPACE_API_KEY=